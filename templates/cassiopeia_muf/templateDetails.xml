<?xml version="1.0" encoding="UTF-8"?>
<extension type="template" client="site">
	<name>cassiopeia_muf</name>
	<version>1.0.0</version>
	<creationDate>2026-10</creationDate>
	<author>The Museum of Unbuilt Futures</author>
	<authorEmail>hello@unbuiltfutures.museum</authorEmail>
	<copyright>(C) 2026 The Museum of Unbuilt Futures. Based on Cassiopeia (C) Open Source Matters.</copyright>
	<description>TPL_CASSIOPEIA_MUF_XML_DESCRIPTION</description>
	<inheritable>0</inheritable>
	<parent>cassiopeia</parent>
	<files>
		<filename>component.php</filename>
		<filename>error.php</filename>
		<filename>index.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>offline.php</filename>
		<filename>templateDetails.xml</filename>
		<folder>html</folder>
		<folder>language</folder>
	</files>
	<media destination="templates/site/cassiopeia_muf" folder="media">
		<folder>images</folder>
	</media>
	<positions>
		<!-- Site chrome -->
		<position>topbar</position>
		<position>menu</position>
		<position>search</position>
		<position>breadcrumbs</position>
		<position>sidebar-left</position>
		<position>sidebar-right</position>
		<position>main-top</position>
		<position>main-bottom</position>
		<position>debug</position>
		<!-- Homepage bands, in display order -->
		<position>muf-hero</position>
		<position>muf-current</position>
		<position>muf-archive</position>
		<position>muf-collection</position>
		<position>muf-events</position>
		<position>muf-curator</position>
		<position>muf-journal</position>
		<position>muf-visit</position>
		<!-- Footer columns -->
		<position>muf-footer-brand</position>
		<position>muf-footer-nav</position>
		<position>muf-footer-visit</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/tpl_cassiopeia_muf.ini</language>
		<language tag="en-GB">en-GB/tpl_cassiopeia_muf.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="advanced">
				<field
					name="stickyHeader"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					filter="integer"
					label="TPL_CASSIOPEIA_MUF_STICKY_LABEL"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="backTop"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					filter="integer"
					label="TPL_CASSIOPEIA_MUF_BACKTOTOP_LABEL"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
